   NumberParseInt,
   ObjectDefineProperty,
   ObjectFreeze,
@@ -109,6 +110,7 @@ function prepareExecution(options) {
 
   // Patch the process object and get the resolved main entry point.
   const mainEntry = patchProcessObject(expandArgv1);
+  setupWebAssemblyPolyfill();
   setupTraceCategoryState();
   setupInspectorHooks();
   setupNetworkInspection();
@@ -364,6 +366,10 @@ function setupEventsource() {
   }
 }
 
+// The private Android App build retains JIT and native WebAssembly.
