From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lilixu3 <240407887+lilixu3@users.noreply.github.com>
Date: Tue, 13 Oct 2026 16:40:00 +0800
Subject: [PATCH] build: private App QUIC runtime default

Make the compiled private Android QUIC module available without changing
App startup arguments. The explicit disabling flag remains supported.
---
 src/node_options.h | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/node_options.h b/src/node_options.h
index f8aa582538..47e73e9568 100644
--- a/src/node_options.h
+++ b/src/node_options.h
@@ -220,7 +220,13 @@ class EnvironmentOptions : public Options {
   DEFINE_BOOL_FIELD(sea_vfs_archive) = false;
   DEFINE_BOOL_FIELD(webstorage) = HAVE_SQLITE;
   DEFINE_BOOL_FIELD(experimental_dtls) = EXPERIMENTALS_DEFAULT_VALUE;
-  DEFINE_BOOL_FIELD(experimental_quic) = EXPERIMENTALS_DEFAULT_VALUE;
+  // Private App runtime compiles QUIC and makes node:quic available by default.
+  // The explicit --no-experimental-quic switch still disables it.
+#ifndef OPENSSL_NO_QUIC
+  DEFINE_BOOL_FIELD(experimental_quic) = true;
+#else
+  DEFINE_BOOL_FIELD(experimental_quic) = false;
+#endif
   DEFINE_BOOL_FIELD(experimental_global_navigator) = true;
   DEFINE_BOOL_FIELD(experimental_global_web_crypto) = true;
   DEFINE_BOOL_FIELD(experimental_import_text) = EXPERIMENTALS_DEFAULT_VALUE;
