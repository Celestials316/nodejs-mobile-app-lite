+void TLSWrap::SetECHConfigList(const FunctionCallbackInfo<Value>& args) {
+  TLSWrap* wrap;
+  ASSIGN_OR_RETURN_UNWRAP(&wrap, args.This());
+  CHECK_EQ(args.Length(), 1);
+  CHECK(args[0]->IsArrayBufferView());
+  CHECK(!wrap->flags_.started);
+  CHECK(wrap->is_client());
+  CHECK(wrap->ssl_);
+  ArrayBufferViewContents<uint8_t> config(args[0]);
+  args.GetReturnValue().Set(crypto::ConfigureECH(
+      wrap->ssl_.get(), config.data(), config.length()));
+}
+
+void TLSWrap::GetECHStatus(const FunctionCallbackInfo<Value>& args) {
+  TLSWrap* wrap;
+  ASSIGN_OR_RETURN_UNWRAP(&wrap, args.This());
+  if (wrap->ssl_) {
+    args.GetReturnValue().Set(crypto::GetECHStatus(wrap->ssl_.get()));
+  }
+}
